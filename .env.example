# Скопируйте в .env. Настоящий .env в git не попадает (.gitignore).
OPENAI_API_KEY=            # ключ OpenAI; можно оставить пустым — тогда работает детерминированный режим
OPENAI_MODEL=gpt-6-sol     # модель для объяснений и агента-советника
DEMO_MODE=false            # true = принудительно детерминированный режим без обращений к API
APP_PORT=8000
